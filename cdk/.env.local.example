# Deploy-time secrets — copy to `.env.local` and fill in.
#
#   cp cdk/.env.local.example cdk/.env.local
#
# `.env.local` is gitignored. Never commit real values.
#
# scripts/deploy.sh sources `.env.local` automatically, so once it exists you
# can deploy without exporting anything:
#
#   ./scripts/deploy.sh -e prod -r us-east-1
#
# Only genuine secrets belong here. Everything that is the same for every
# deployer — the Mantle endpoint URL, CloudFront domain and certificate, VPC
# sizing — lives in config/config.ts so it is version-controlled and cannot
# silently differ between machines.

# --- Required when enableOpenaiCompat or enableOpenaiPassthrough is true ---
# Bedrock API key (bearer token) for the Mantle endpoint. Starts with "ABSK".
# Generate in the Bedrock console under "API keys".
# The synth fails with a clear message if this is missing, rather than
# deploying a proxy that 502s on every /openai/v1/* request.
BEDROCK_API_KEY=

# --- Required only when enableWebSearch is true ---
# Tavily ("tvly-...") or Brave key, matching webSearchProvider in config.ts.
#WEB_SEARCH_API_KEY=

# --- Required only when enableTracing is true ---
# e.g. Authorization=Basic <base64(publicKey:secretKey)> for Langfuse.
#OTEL_EXPORTER_OTLP_HEADERS=

# --- Optional overrides ---
# Point a deploy at a different Mantle region than config.ts specifies.
#MANTLE_ENDPOINT_URL=
