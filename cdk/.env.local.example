# Deploy-time secrets — copy to `.env.local` and fill in.
#
#   cp cdk/.env.local.example cdk/.env.local
#
# `.env.local` is gitignored. Never commit real values.
#
# scripts/deploy.sh sources `.env.local` automatically, so once it exists you
# can deploy without exporting anything:
#
#   ./scripts/deploy.sh -e prod -r us-east-1
#
# Only genuine secrets belong here. Everything that is the same for every
# deployer — the OpenAI-compatible endpoint URL, CloudFront domain and
# certificate, VPC sizing — lives in config/config.ts so it is version-controlled
# and cannot silently differ between machines.

# --- OpenAI-compatible surface (opt-in) ---
# Mounts /openai/v1/{chat/completions,responses,models} for clients that speak
# OpenAI natively (e.g. the Codex CLI). Upstream is Bedrock Runtime
# (/openai/v1 in the deploy region), signed with the ECS task role, so no API
# key is needed.
#ENABLE_OPENAI_PASSTHROUGH=true

# --- Only for a custom non-Runtime endpoint (MANTLE_ENDPOINT_URL below) ---
# Bedrock API key (bearer token). Starts with "ABSK". Not needed for the
# default Bedrock Runtime endpoint. The synth fails with a clear message if a
# non-Runtime endpoint is configured without it.
#BEDROCK_API_KEY=

# --- Required only when enableWebSearch is true ---
# Tavily ("tvly-...") or Brave key, matching webSearchProvider in config.ts.
#WEB_SEARCH_API_KEY=

# --- Required only when enableTracing is true ---
# e.g. Authorization=Basic <base64(publicKey:secretKey)> for Langfuse.
#OTEL_EXPORTER_OTLP_HEADERS=

# --- Deployment-specific infrastructure (not committed) ---
# Custom domain for the CloudFront distribution. Both must be set together, and
# the ACM certificate MUST be in us-east-1 (CloudFront accepts no other region).
# Leave unset to serve the default *.cloudfront.net hostname.
#CLOUDFRONT_DOMAIN_NAME=api.example.com
#CLOUDFRONT_CERTIFICATE_ARN=arn:aws:acm:us-east-1:<account-id>:certificate/<cert-id>

# --- Optional overrides ---
# Point the OpenAI-compatible surface at a different endpoint than the
# deploy region's Bedrock Runtime (config.ts default).
#MANTLE_ENDPOINT_URL=https://bedrock-runtime.us-east-2.amazonaws.com/openai/v1
